    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "html-to-text": "^9.0.5",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.16.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "xml2js": "^0.6.2",
    "yauzl": "^3.2.0"
