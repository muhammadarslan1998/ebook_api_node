# Server Configuration
PORT=3000
NODE_ENV=production

# Security & Authentication
# REQUIRED: Set a secret token to protect /api/convert/* endpoints
API_AUTH_TOKEN=your_secure_api_key_here

# File upload and retention settings
MAX_FILE_SIZE_MB=100
OUTPUT_TTL_MS=3600000

# Calibre binary paths (required for MOBI, AZW3, LRF, FB2, etc.)
# Default path on Debian/Ubuntu: /usr/bin/ebook-convert
CALIBRE_BIN=/usr/bin/ebook-convert
CALIBRE_DEBUG_BIN=/usr/bin/calibre-debug

# Keep-alive ping (optional for free cloud tiers, can be false on Hostinger)
ENABLE_SELF_PING=false
