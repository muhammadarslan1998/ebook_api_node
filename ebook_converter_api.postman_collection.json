{
  "info": {
    "name": "eBook Converter API",
    "_postman_id": "a3b98721-6541-477f-94d1-872f23b207e9",
    "description": "Comprehensive Postman collection for testing the eBook Converter API endpoints including health, format metadata, sync and async conversion, downloads, and cleanup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "your_secure_api_key_here",
      "type": "string"
    },
    {
      "key": "jobId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Diagnostics",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Returns server status, uptime, memory usage, and active job metrics."
          }
        },
        {
          "name": "Keep-Alive / Refresh",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "refresh"]
            },
            "description": "Lightweight ping endpoint used to keep server awake on cloud hosting platforms."
          }
        }
      ]
    },
    {
      "name": "Formats",
      "item": [
        {
          "name": "Get Supported Formats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/convert/formats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "convert", "formats"]
            },
            "description": "Returns dictionary of supported input formats and their possible target output formats."
          }
        }
      ]
    },
    {
      "name": "Conversions",
      "item": [
        {
          "name": "Convert File (Sync - JSON response)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response && response.jobId) {",
                  "    pm.collectionVariables.set('jobId', response.jobId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "targetFormat",
                  "value": "pdf",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/convert",
              "host": ["{{baseUrl}}"],
              "path": ["api", "convert"]
            },
            "description": "Converts an uploaded file synchronously and returns JSON with the download URL."
          }
        },
        {
          "name": "Convert File (Sync - Direct Stream Download)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "targetFormat",
                  "value": "html",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/convert?direct=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "convert"],
              "query": [
                {
                  "key": "direct",
                  "value": "true"
                }
              ]
            },
            "description": "Directly streams back the converted binary file attachment in the HTTP response."
          }
        },
        {
          "name": "Convert File (Async - Background Job)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response && response.jobId) {",
                  "    pm.collectionVariables.set('jobId', response.jobId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "targetFormat",
                  "value": "epub",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/convert/async",
              "host": ["{{baseUrl}}"],
              "path": ["api", "convert", "async"]
            },
            "description": "Starts conversion in background and immediately responds with 202 Accepted and jobId."
          }
        }
      ]
    },
    {
      "name": "Jobs & Download",
      "item": [
        {
          "name": "Get Job Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/convert/job/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "convert", "job", "{{jobId}}"]
            },
            "description": "Polls status of an async job (queued, processing, done, failed)."
          }
        },
        {
          "name": "Download Converted File",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/convert/download/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "convert", "download", "{{jobId}}"]
            },
            "description": "Downloads the converted document for a completed job."
          }
        }
      ]
    },
    {
      "name": "Maintenance",
      "item": [
        {
          "name": "Trigger Cleanup",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cleanup?ttlMinutes=60",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cleanup"],
              "query": [
                {
                  "key": "ttlMinutes",
                  "value": "60"
                }
              ]
            },
            "description": "Prunes temporary upload and converted files older than the specified TTL in minutes."
          }
        }
      ]
    }
  ]
}
